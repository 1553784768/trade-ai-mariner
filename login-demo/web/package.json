{
  "name": "trade-ai",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint . && node scripts/check-style.mjs && prettier --check .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:8017/api/tariff/openapi.json -o src/lib/api-types.ts",
    "format": "prettier --write .",
    "build:export": "next build",
    "test": "vitest run"
  },
  "dependencies": {
    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.105.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "license": "AGPL-3.0"
}
